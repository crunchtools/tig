[Unit]
Requires=srv-secrets@telegraf-receiver.crunchtools.com.service
After=srv-secrets@telegraf-receiver.crunchtools.com.service
Description=Podman container - telegraf-receiver.crunchtools.com (OTLP receiver for Trentina traces)
Documentation=https://github.com/crunchtools/tig
Wants=network-online.target influxdb.crunchtools.com.service
After=network-online.target influxdb.crunchtools.com.service

# Unlike telegraf-host.crunchtools.com, this one answers requests: it receives
# Trentina's spans on the `crunchtools` bridge (alias `telegraf-receiver`, port 4318) with
# basic auth. So it gets none of the host collector's reach: no host network,
# PID namespace, Podman socket or host filesystem, no capabilities, and no
# published port. It holds a write-only InfluxDB token.

[Service]
Type=simple
Restart=always
RestartSec=10
ExecStartPre=/usr/bin/sleep 1.5
ExecStartPre=-/usr/bin/podman rm -f telegraf-receiver.crunchtools.com
ExecStart=/usr/bin/podman run \
    --label io.containers.autoupdate=registry \
    --label PODMAN_SYSTEMD_UNIT=telegraf-receiver.crunchtools.com.service \
    --memory=128m \
    --memory-swap=128m \
    --rm \
    --name telegraf-receiver.crunchtools.com \
    --network crunchtools \
    --network-alias telegraf-receiver \
    --read-only \
    --tmpfs /tmp \
    --cap-drop=all \
    --security-opt no-new-privileges \
    --env-file /run/srv-secrets/telegraf-receiver.crunchtools.com/telegraf-receiver.env \
    -v /srv/telegraf-receiver.crunchtools.com/config/etc:/etc/telegraf:ro,Z \
    quay.io/crunchtools/tig:latest telegraf
ExecStop=/usr/bin/podman stop -t 10 telegraf-receiver.crunchtools.com
ExecStopPost=/usr/bin/podman rm -f telegraf-receiver.crunchtools.com

[Install]
WantedBy=multi-user.target
