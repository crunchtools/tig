# /srv/mcp-grafana.crunchtools.com/config/mcp-grafana.env  (mode 0600)
# GRAFANA_SERVICE_ACCOUNT_TOKEN: a token for a Grafana service account with the
#   Viewer role. MCP_GRAFANA_SERVER_TOKEN: the bearer the gateway must present.
GRAFANA_URL=http://grafana:3000
GRAFANA_SERVICE_ACCOUNT_TOKEN=change-me
MCP_GRAFANA_SERVER_TOKEN=change-me
