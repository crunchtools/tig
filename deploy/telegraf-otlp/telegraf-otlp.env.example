# /srv/telegraf-otlp.crunchtools.com/config/telegraf-otlp.env (0600)
INFLUX_URL=http://influxdb:8086
INFLUX_ORG=crunchtools
INFLUX_BUCKET=telegraf
# A write-only token (influxdb-bootstrap token write).
INFLUX_TOKEN=
# Trentina's side, in trentina.env:
#   TRENTINA_OTLP_ENDPOINT=http://otlp:4318
#   TRENTINA_OTLP_HEADERS=Authorization=Basic%20<base64 of user:pass>
#   TRENTINA_OTLP_INSECURE=true   (plain http, but only across the crunchtools bridge)
OTLP_USERNAME=trentina
OTLP_PASSWORD=
