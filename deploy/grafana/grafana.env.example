# /srv/grafana.crunchtools.com/config/grafana.env  (mode 0600)
# INFLUXDB_TOKEN must be the read-only token (never the admin token), from:
#   podman exec influxdb.crunchtools.com influxdb-bootstrap token read
# ALERT_WEBHOOK_URL is where trend alerts are POSTed as JSON: the on-call
#   agent's alert ingress. ALERT_WEBHOOK_TOKEN is its secret, sent as
#   Authorization: Bearer so it stays out of every access log on the way.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me
INFLUXDB_TOKEN=change-me
ALERT_WEBHOOK_URL=https://gateway.example.com/alert
ALERT_WEBHOOK_TOKEN=change-me
