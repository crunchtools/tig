# /srv/grafana.crunchtools.com/config/grafana.env  (mode 0600)
# INFLUXDB_TOKEN comes from:
#   podman exec influxdb.crunchtools.com influxdb-bootstrap token read
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me
GF_SMTP_ENABLED=true
GF_SMTP_HOST=smtp.example.com:25
GF_SMTP_FROM_ADDRESS=grafana@example.com
GF_SMTP_SKIP_VERIFY=true
INFLUXDB_TOKEN=change-me
ALERT_EMAIL=ops@example.com
