# /srv/telegraf.crunchtools.com/config/telegraf.env  (mode 0600)
# INFLUX_TOKEN must be the write-only token (never the admin token), from:
#   podman exec influxdb.crunchtools.com influxdb-bootstrap token write
INFLUX_URL=http://127.0.0.1:8099
INFLUX_ORG=crunchtools
INFLUX_BUCKET=telegraf
INFLUX_TOKEN=change-me
HOST_MOUNT_PREFIX=/hostfs
