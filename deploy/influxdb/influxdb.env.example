# /srv/influxdb.crunchtools.com/config/influxdb.env  (mode 0600)
# Read once by influxdb-bootstrap on first start; the admin token is used on
# every start to check that the rollup bucket and task still exist.
INFLUXDB_INIT_USERNAME=admin
INFLUXDB_INIT_PASSWORD=change-me
INFLUXDB_INIT_ORG=crunchtools
INFLUXDB_INIT_BUCKET=telegraf
# Whole days.
INFLUXDB_INIT_RETENTION=90d
INFLUXDB_INIT_ADMIN_TOKEN=change-me
HOME=/var/lib/influxdb2
GOMEMLIMIT=600MiB
